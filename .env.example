# Bukara Web App – Umgebungsvariablen
#
# Diese Datei dokumentiert die benötigten Variablen. Kopieren nach `.env.local`
# (lokal) bzw. im Vercel-Projekt unter Settings → Environment Variables setzen –
# für Production UND Preview, sonst laufen die Preview-Deployments ohne Supabase-
# bzw. Mail-Zugang. Hier stehen nur Platzhalter, KEINE echten Secrets.

# --- Supabase (öffentlich, im Browser sichtbar) ---
# Projekt-URL und anon/publishable Key. Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# --- Supabase (geheim, nur serverseitig) ---
# Service-Role-Key für serverseitige Aktionen (Bestellungen, Gutscheine, Admin).
# NIEMALS an den Client geben oder ins Repo committen.
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>

# --- Site-URL (optional) ---
# Wenn gesetzt, werden Auth-/Reset-Links darauf aufgebaut, sonst aus den
# Request-Headern abgeleitet. Für Preview i. d. R. weglassen (dann greift die
# jeweilige Vercel-Preview-Domain automatisch). Für Production z. B.:
# NEXT_PUBLIC_SITE_URL=https://www.bukara.de
NEXT_PUBLIC_SITE_URL=

# --- Transaktions-Mail für /api/send-email (nicht Supabase-Auth) ---
# SMTP-Zugang für Bestell-/Anfrage-Mails aus der App heraus.
# (Supabase-Auth-Mails werden separat im Supabase-Dashboard konfiguriert,
#  siehe docs/auth-setup.md.)
EMAIL_USER=<smtp-benutzer-oder-absenderadresse>
EMAIL_PASS=<smtp-passwort-oder-app-passwort>
EMAIL_TO=<empfaengeradresse-fuer-benachrichtigungen>
